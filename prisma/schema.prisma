// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile      Profile?
  tasks        Task[]
  universities SavedUniversity[]
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Academic
  educationLevel String?
  degree         String?
  graduationYear String?
  gpa            String?

  // Goals
  targetDegree       String?
  fieldOfStudy       String?
  targetIntake       String?
  preferredCountries String? // Stored as comma-separated string for simplicity

  // Budget
  budgetRange String?
  fundingPlan String?

  // Readiness
  ieltsScore String?
  greScore   String?
  sopStatus  String? // 'Not Started', 'Draft', 'Ready'

  isComplete Boolean @default(false)
}

model Task {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  description String?
  status      String   @default("PENDING") // PENDING, COMPLETED
  createdAt   DateTime @default(now())
  isSystem    Boolean  @default(false) // If generated by AI or system
}

model SavedUniversity {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  name     String
  location String?
  website  String?

  matchScore Int? // 0-100
  category   String? // Dream, Target, Safe
  isLocked   Boolean @default(false)

  createdAt DateTime @default(now())
}
